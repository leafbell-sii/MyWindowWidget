; =============================================================
;  MyWindowWidget - Google Tasks card (shared by Tasks\List1..4)
;
;  Included by the slot skins (Tasks\ListN\Tasks.ini), which set
;  TasksSlot=N first. Checked 2026-11-17: keys at the top of an
;  included file do NOT join the including section, hence the
;  explicit [Variables] header below. Each slot is its own Rainmeter config, so
;  several lists can be on screen at once; slot N shows list N
;  until < > picks another one (remembered per slot).
;
;  Data comes from @Resources\Scripts\Tasks.lua, which runs
;  GTasks.ps1 (OAuth 2.0 + Google Tasks API) in a hidden window
;  through the bundled RunCommand plugin. Adding uses the bundled
;  InputText plugin. Sign-in is a one-time console step, see
;  README "Google Tasks".
;
;  Mouse: list name = sync now, < > = other list, circle = mark
;  as done, "+ Add task" = type a new task (Enter adds, Esc or
;  click elsewhere cancels).
;
;  The row meters below were generated by a script; they only
;  differ in their numbers. Lua shows TasksRows of them (max 10).
; =============================================================
[Variables]
CardW=#TasksWidth#
Ic=#IconSize#
RowH=(24*#Scale#)
HeadH=(20*#Scale#)
TaskIndent=(18*#Scale#)
DueW=(70*#Scale#*#FontScale#)
ListY=(#Pad#+#HeadH#+#Gap#/2)
SepY=(#ListY#+#TasksRows#*#RowH#+#Gap#/2)
FootY=(#SepY#+#Gap#/2)
CardH=(#FootY#+#RowH#+#Pad#/2)

; ---- Measures -----------------------------------------------

; Parameter is set by Tasks.lua before every Run. Hide kills the
; script if the skin is refreshed or unloaded mid-run. Timeout
; (ms) stops a hung run; FinishAction still fires.
[MeasureRun]
Measure=Plugin
Plugin=RunCommand
State=Hide
Timeout=60000
FinishAction=[!CommandMeasure MeasureTasks "OnDone()"]

[MeasureTasks]
Measure=Script
ScriptFile=#@#Scripts\Tasks.lua

; Edit box over the footer row. InputText can only use fonts
; installed in Windows (not @Resources\Fonts): InputFontFace.
; Triple quotes keep a " typed by the user inside the bang; the
; Lua long string [==[ ]==] keeps quotes and backslashes as-is.
[MeasureTaskInput]
Measure=Plugin
Plugin=InputText
X=#Pad#
Y=(#FootY#+2*#Scale#)
W=(#CardW#-2*#Pad#)
H=(#RowH#-4*#Scale#)
SolidColor=#ColorBgRGB#,255
FontColor=#ColorTextPrimary#
FontFace=#InputFontFace#
FontSize=#FontSizeM#
InputLimit=1024
FocusDismiss=1
Command1=[!CommandMeasure MeasureTasks """Add([==[$UserInput$]==])"""]

; ---- Styles -------------------------------------------------

[StyleChevron]
Shape=Rectangle 0,0,#Ic#,#Ic# | Fill Color 0,0,0,1 | StrokeWidth 0
ChevronStroke=Fill Color 0,0,0,0 | StrokeWidth #IconStrokeW# | Stroke Color #ColorTextSecondary# | StrokeStartCap Round | StrokeEndCap Round | StrokeLineJoin Round

; Round check box; the tick shows on hover. Lua sets X (indent
; for subtasks).
[StyleTaskCheck]
X=#Pad#
Shape=Ellipse (#Ic#/2),(#Ic#/2),(#Ic#/2-#IconStrokeW#) | Fill Color 0,0,0,1 | StrokeWidth #IconStrokeW# | Stroke Color #ColorTextSecondary#
Shape2=Path CheckPath | Fill Color 0,0,0,0 | StrokeWidth #IconStrokeW# | StrokeStartCap Round | StrokeEndCap Round | StrokeLineJoin Round | Extend CheckColor
CheckPath=(#Ic#*0.3),(#Ic#*0.52) | LineTo (#Ic#*0.45),(#Ic#*0.67) | LineTo (#Ic#*0.72),(#Ic#*0.36)
CheckColor=Stroke Color 0,0,0,0
MouseOverAction=[!SetOption #CURRENTSECTION# CheckColor "Stroke Color #ColorAccent#"][!UpdateMeter #CURRENTSECTION#][!Redraw]
MouseLeaveAction=[!SetOption #CURRENTSECTION# CheckColor "Stroke Color 0,0,0,0"][!UpdateMeter #CURRENTSECTION#][!Redraw]
ToolTipText=Mark as done
Hidden=1
Group=Tasks

; Lua sets X, W, Text, ToolTipText, FontColor.
[StyleTaskText]
StringAlign=LeftCenter
X=#Pad#
ClipString=1
Hidden=1
Group=Tasks

[StyleTaskDue]
StringAlign=RightCenter
X=(#CardW#-#Pad#)
Hidden=1
Group=Tasks

; ---- Meters -------------------------------------------------

[MeterBg]
Meter=Shape
MeterStyle=StyleCard
@IncludeCardArt=#@#CardArt.inc

[MeterListName]
Meter=String
MeterStyle=StyleText | StyleTitle
StringAlign=LeftCenter
Y=(#Pad#+#HeadH#/2)
W=(#CardW#-2*#Pad#-2*#Ic#-2*#Gap#)
ClipString=1
Text=Google Tasks
ToolTipText=Sync now
LeftMouseUpAction=[!CommandMeasure MeasureTasks "Refresh()"]
Group=Tasks

[MeterPrev]
Meter=Shape
MeterStyle=StyleChevron
X=(#CardW#-#Pad#-2*#Ic#-#Gap#)
Y=(#Pad#+#HeadH#/2-#Ic#/2)
Shape2=Path ChevronLeft | Extend ChevronStroke
ChevronLeft=(#Ic#*0.65),(#Ic#*0.15) | LineTo (#Ic#*0.3),(#Ic#*0.5) | LineTo (#Ic#*0.65),(#Ic#*0.85)
ToolTipText=Previous list
LeftMouseUpAction=[!CommandMeasure MeasureTasks "PrevList()"]
Hidden=1

[MeterNext]
Meter=Shape
MeterStyle=StyleChevron
X=(#CardW#-#Pad#-#Ic#)
Y=(#Pad#+#HeadH#/2-#Ic#/2)
Shape2=Path ChevronRight | Extend ChevronStroke
ChevronRight=(#Ic#*0.35),(#Ic#*0.15) | LineTo (#Ic#*0.7),(#Ic#*0.5) | LineTo (#Ic#*0.35),(#Ic#*0.85)
ToolTipText=Next list
LeftMouseUpAction=[!CommandMeasure MeasureTasks "NextList()"]
Hidden=1

; Loading / not connected / no open tasks.
[MeterEmpty]
Meter=String
MeterStyle=StyleText | StyleBody
FontColor=#ColorTextSecondary#
StringAlign=CenterCenter
X=(#CardW#/2)
Y=(#ListY#+#TasksRows#*#RowH#/2)
W=(#CardW#-2*#Pad#)
H=(#TasksRows#*#RowH#)
ClipString=2
Text=
Group=Tasks


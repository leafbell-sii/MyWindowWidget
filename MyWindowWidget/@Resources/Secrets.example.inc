; =============================================================
;  MyWindowWidget - secrets TEMPLATE
;  Copy this file to Secrets.inc (same folder) and fill it in.
;  Secrets.inc is in .gitignore - never commit or share it.
;
;  Google Calendar > Settings > (your calendar) > Integrate
;  calendar > "Secret address in iCal format". Paste the whole
;  https://calendar.google.com/calendar/ical/.../basic.ics URL.
;  Anyone with this address can read the calendar, so treat it
;  like a password. If it leaks, use "Reset" in Google Calendar.
;
;  Up to 4 calendars; leave unused ones empty. Each gets a dot
;  colour from ColorCal1..4 in the theme file.
; =============================================================
[Variables]
ICalUrl1=
ICalUrl2=
ICalUrl3=
ICalUrl4=
